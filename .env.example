# Copy to .env for local testing. Set the same variables as server-only Vercel secrets in production.
DATABASE_URL=
PREMIUM_APP_URL=http://localhost:5173
PREMIUM_SESSION_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional card checkout presentment currencies (USD is always enabled).
PREMIUM_CURRENCIES=PKR,EUR,GBP,CAD,AUD
# Optional estimated model rates per million tokens, as USD numbers.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=

# Pakistan checkout: use sandbox in a private test deployment, then production with live keys.
PREMIUM_PAYMENT_PROVIDER=safepay
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_PUBLIC_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_PRICE_PKR=280
