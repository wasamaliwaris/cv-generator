# No variables are required for the free checker and uploads up to 4 MiB.
# Optional private, short-lived upload staging and distributed rate limiting.
# ATS_REDIS_URL=https://your-redis-rest-host.example
# ATS_REDIS_TOKEN=
# ATS_UPLOAD_SECRET=

# Optional: trusted operators can issue time-limited Premium access codes.
# This is not a billing integration. Use separate random secrets in each environment.
# ATS_ACCESS_SECRET=
# OPENAI_API_KEY=
# ATS_OPENAI_MODEL=gpt-4.1-mini

# Optional additional trusted origin for a reverse proxy with a different host header.
# ATS_APP_ORIGIN=https://pathcv.app
