{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/ats.mjs": {
      "maxDuration": 40,
      "includeFiles": "{server/ats-pdf-worker.mjs,server/ats-doc-worker.mjs,node_modules/word-extractor/**,node_modules/pdfjs-dist/package.json,node_modules/pdfjs-dist/legacy/build/pdf.mjs,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs,node_modules/pdfjs-dist/standard_fonts/**,node_modules/pdfjs-dist/cmaps/**}"
    }
  }
}
